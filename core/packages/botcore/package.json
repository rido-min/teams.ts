  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@stylistic/eslint-plugin": "^4.2.0",
    "@types/debug": "^4.1.13",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.0",
    "eslint": "^9.25.1",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.3",
