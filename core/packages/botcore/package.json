{
  "name": "@microsoft/teams.botcore",
  "version": "0.0.0",
  "description": "Core bot framework for Microsoft Teams",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "homepage": "https://github.com/microsoft/teams.ts",
